# ============================================================
# SkillAlign AI Service — Environment Variables
# Salin file ini ke .env dan isi nilainya:
#   cp .env.example .env
# ============================================================

# ── Gemini (wajib untuk Learning Path feature) ────────────────
# Dapatkan di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── YouTube Data API v3 (opsional) ────────────────────────────
# Dapatkan di: https://console.cloud.google.com → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── Supabase (wajib untuk caching Learning Path) ──────────────
# Dapatkan di: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Model paths ───────────────────────────────────────────────
# v3 = model yang tersedia di repo (deployed di Cloud Run)
# v4 = model terbaru dari notebook (belum di-push, training di Colab)
MODEL_PATH=models/skillalign_matcher_v3.keras
PREPROCESSOR_PATH=preprocessors/nlp_preprocessor_v3.pkl
CONFIG_PATH=models/model_config_v3.json

# ── Inference settings ─────────────────────────────────────────
# OPTIMAL_THRESHOLD: dikalibrasi dari val set (Fase 3B, F1=0.9089)
# Jika tidak di-set, dibaca dari model_config_v4.json → default 0.44
OPTIMAL_THRESHOLD=0.44

# Hybrid scoring: gabungkan model score dengan structured keyword score
# Set false untuk pakai raw model score saja (lebih cepat)
USE_HYBRID=true

# ── Model Download URLs (untuk Railway deployment) ─────────────
# Isi URL ini jika model TIDAK di-commit ke git.
# Cara mendapatkan URL Google Drive direct download:
#   1. Buka file di Drive → Bagikan → Siapa saja yang punya link
#   2. Salin file ID dari URL (format: /d/FILE_ID/view)
#   3. Format URL: https://drive.google.com/uc?export=download&id=FILE_ID
#
# Alternatif: upload ke GitHub Releases dan gunakan URL asset langsung.
MODEL_DOWNLOAD_URL=
PREPROCESSOR_DOWNLOAD_URL=
EMB_MANAGER_DOWNLOAD_URL=
CONFIG_DOWNLOAD_URL=
